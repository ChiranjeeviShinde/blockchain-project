# BlockTix Ethereum & Sepolia Configuration
# Copy this file to .env and configure your values.
# NEVER commit your private keys or real secrets to git!

# Deployed Smart Contract Address on Sepolia Testnet (Chain ID 11155111)
# Example: VITE_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
VITE_CONTRACT_ADDRESS=

# Optional: Default Sepolia RPC Endpoint
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional (Only for scripts/deploy.js command line deployment):
# DEPLOYER_PRIVATE_KEY=your_testnet_private_key_without_0x
